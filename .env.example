# Copy to .env and fill in.
ANTHROPIC_API_KEY=

# Voice for Safari, iPhone and Firefox (recommended, about $4 per million characters).
# Chrome and Edge keep using their own free Google/Natural voice; other browsers
# get the same Google Hindi voice from Google Cloud. Key: console.cloud.google.com,
# enable "Cloud Text-to-Speech API", then Credentials > API key (restrict it to that API).
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=hi-IN-Wavenet-A

# ElevenLabs instead (costly at high traffic). When set, every browser uses it.
ELEVENLABS_API_KEY=
# Pick a voice at https://elevenlabs.io/app/voice-library (an Indian English voice suits the store best)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_BASE_URL=https://api.in.residency.elevenlabs.io

# Pilot report, settings page and spending guard (all can also be set on /admin.html)
# demo = answers through the Claude app on this computer (free); live = through ANTHROPIC_API_KEY
MODE=live
# Password for /report.html and /admin.html (without it they only open on the server itself)
REPORT_TOKEN=
# Once Sonnet has used this much in a month, Haiku answers everything until the 1st
SONNET_BUDGET_USD=500
# Hard limit for the month, everything included: the chat pauses here. Set the same
# amount as the spend limit in the Anthropic console.
MONTHLY_BUDGET_USD=600
# Semrush average monthly visits (India, desktop + mobile), for the report's forecast
MONTHLY_VISITS=1665170

# Optional
PORT=3030
CLAUDE_MODEL=claude-sonnet-5-5
# The cheaper model plans searches and takes over when the Sonnet budget runs out.
# ROUTING=on also sends greetings and simple price/stock lookups to it (cheaper, less salesy).
CLAUDE_FAST_MODEL=claude-haiku-5-5
ROUTING=off
ASSISTANT_NAME=Prestige Assistant
# Comma-separated sites allowed to call the API from a browser (use * while testing)
ALLOWED_ORIGINS=https://shop.ttkprestige.com,http://localhost:3030
